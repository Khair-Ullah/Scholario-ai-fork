# Public API origin used by the browser (client-side fetch).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional server-side API origin for the landing page data.
# Falls back to NEXT_PUBLIC_API_URL, then http://localhost:8000.
BACKEND_URL=

# Google Identity Services client id. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
