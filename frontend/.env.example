# Leave empty in production (Vercel): the browser calls the same-origin /api
# proxy, which forwards to BACKEND_URL and keeps auth cookies host-only.
# Set http://localhost:8000 only for local development outside Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side API origin used by the /api rewrite. Required on Vercel.
BACKEND_URL=

# Google Identity Services client id. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_AUTH_OTP_MODE=pending
