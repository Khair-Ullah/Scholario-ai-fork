# Production (Vercel + Railway): APP_ENV=production, SECRET_KEY from a secret
# manager, DATABASE_URL from Railway Postgres, FRONTEND_ORIGINS/FRONTEND_BASE_URL
# set to the public HTTPS domain, TRUST_PROXY_HEADERS=true, PORT from Railway.
APP_ENV=development
SECRET_KEY=replace-this-with-a-long-random-value-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
DATABASE_URL=postgresql+psycopg://scholario:change_this_strong_password@localhost:5432/scholario
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY_HEADERS=false
CONTACT_INBOX=support@scholario.ai
SEVEN_PLUS_SEES_ALL=false
TOTP_ISSUER=Scholario
AI_PROVIDER=mock
AI_MODEL=gemini-3.6-flash
AI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.8-flash
AI_TIMEOUT_SECONDS=30
AI_THINKING_BUDGET=0
AI_FALLBACK_TO_MOCK=true
AI_CUSTOM_URL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Scholario <no-reply@scholario.ai>"
SMTP_SSL=false
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN=60
